@using MultiPlanerApp.Models
@using MultiPlanerApp.Services
@inject EventService EventApi

<Popup IsVisible="IsVisible" Title="Event details" OnClose="OnClose">
    @if (Event != null)
    {
        <div class="event-details">
            <div class="event-details-color-bar" style="background-color: #@Event.Color"></div>
            
            <div class="event-details-row">
                <span class="event-details-label">Name</span>
                <span class="event-details-value">@Event.Title</span>
            </div>
            <div class="event-details-row">
                <span class="event-details-label">User</span>
                <span class="event-details-value">@Event.User</span>
            </div>
            <div class="event-details-row">
                <span class="event-details-label">Start</span>
                <span class="event-details-value">@Event.StartDate.ToString("dd.MM.yyyy")</span>
            </div>
            <div class="event-details-row">
                <span class="event-details-label">End</span>
                <span class="event-details-value">@Event.EndDate.ToString("dd.MM.yyyy")</span>
            </div>
            @if (!string.IsNullOrEmpty(Event.Description))
            {
                <div class="event-details-row event-details-row-column">
                    <span class="event-details-label">Description</span>
                    <span class="event-details-value">@Event.Description</span>
                </div>
            }
            <div class="event-details-row">
                <span class="event-details-label">Priority</span>
                <span class="event-details-value @(Event.IsHighPriority ? "high-priority" : "")">
                    @(Event.IsHighPriority ? "High" : "Normal")
                </span>
            </div>

            <div class="event-details-actions">
                <button class="btn-delete" @onclick="HandleDelete">
                    Delete event
                </button>
            </div>

            @if (!string.IsNullOrEmpty(ErrorMessage))
            {
                <div class="form-error">@ErrorMessage</div>
            }
        </div>
    }
</Popup>

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public Event? Event { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnDeleted { get; set; }

    private string ErrorMessage = "";

    private async Task HandleDelete()
    {
        if (Event == null) return;

        var success = await EventApi.DeleteEventAsync(Event.Id);
        if (success)
        {
            await OnDeleted.InvokeAsync();
            await OnClose.InvokeAsync();
        }
        else
        {
            ErrorMessage = "Failed to delete event";
        }
    }
}