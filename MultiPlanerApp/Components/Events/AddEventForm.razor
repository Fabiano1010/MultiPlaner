@using MultiPlanerApp.Models
@using MultiPlanerApp.Services
@inject EventService EventApi

<Popup IsVisible="IsVisible" Title="Add Event" OnClose="HandleClose">
    <div class="add-event-form">
        <div class="form-group">
            <label>Event name</label>
            <input type="text" @bind="NewEvent.Title" placeholder="Event name" />
        </div>
        <div class="form-group">
            <label>User</label>
            <input type="text" @bind="NewEvent.User" placeholder="User" />
        </div>
        <div class="form-row">
            <div class="form-group">
                <label>Start date</label>
                <input type="date" @bind="NewEvent.StartDate" />
            </div>
            <div class="form-group">
                <label>End date</label>
                <input type="date" @bind="NewEvent.EndDate" />
            </div>
        </div>
        <div class="form-group">
            <label>Description</label>
            <textarea @bind="NewEvent.Description" placeholder="Description" rows="3"></textarea>
        </div>
        <div class="form-row">
            <div class="form-group form-group-color">
                <label>Color</label>
                <input type="color" @bind="ColorPicker" />
            </div>
            <div class="form-group form-group-checkbox">
                <label>
                    <input type="checkbox" @bind="NewEvent.IsHighPriority" />
                    High priority
                </label>
            </div>
        </div>
        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="form-error">@ErrorMessage</div>
        }
        <div class="form-actions">
            <button class="btn-cancel" @onclick="HandleClose">Cancel</button>
            <button class="btn-save" @onclick="HandleSave">Save</button>
        </div>
    </div>
</Popup>

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public DateTime StartDate { get; set; }
    [Parameter] public DateTime EndDate { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }

    private Event NewEvent = new();
    private string ColorPicker { get; set; } = "#999999";
    private string ErrorMessage = "";

    protected override void OnParametersSet()
    {
        if (IsVisible)
        {
            
            NewEvent = new Event
            {
                StartDate = StartDate,
                EndDate = EndDate
            };
            ColorPicker = "#999999";
            ErrorMessage = "";
        }
    }

    private async Task HandleSave()
    {
        if (string.IsNullOrWhiteSpace(NewEvent.Title))
        {
            ErrorMessage = "Event name is required";
            return;
        }

      
        NewEvent.Color = ColorPicker.TrimStart('#');

        var result = await EventApi.AddEventAsync(NewEvent);
        if (result != null)
        {
            await OnSaved.InvokeAsync();
            await OnClose.InvokeAsync();
        }
        else
        {
            ErrorMessage = "Failed to save event";
        }
    }

    private async Task HandleClose()
    {
        ErrorMessage = "";
        await OnClose.InvokeAsync();
    }
}