@if (IsVisible)
{
    <div class="popup-overlay" @onclick="HandleOverlayClick">
        <div class="popup-container" @onclick:stopPropagation="true">
            <div class="popup-header">
                <span class="popup-title">@Title</span>
                <img src="images/x.svg" class="popup-close" @onclick="OnClose">
            </div>
            <div class="popup-content">
                @ChildContent
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private async Task HandleOverlayClick() => await OnClose.InvokeAsync();
}