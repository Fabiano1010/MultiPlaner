@if (_visible)
{
    <div class="ctx-backdrop" @onclick="Hide" @oncontextmenu="Hide" @oncontextmenu:preventDefault></div>
    <div class="ctx-menu" style="left:min(@(_x)px, calc(100vw - 10rem)); top:min(@(_y)px, calc(100vh - 6rem));">
        @ChildContent
    </div>
}

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private bool _visible;
    private double _x, _y;

    public void Show(MouseEventArgs e)
    {
        _x = e.ClientX;
        _y = e.ClientY;
        _visible = true;
        StateHasChanged();
    }
    

    public void Hide()
    {
        _visible = false;
        StateHasChanged();
    }
}