<Popup IsVisible="IsVisible" Title="@Title" OnClose="HandleClose">
    <div class="add-room-form-box">
        <form class="add-room-form" @onsubmit="HandleSave" @onsubmit:preventDefault>
            <div class="form-group">
                <label>Name</label>
                <input type="text" @bind="_name" @bind:event="oninput"
                       class="input-main @(hasError ? "error-input" : "")"/>
            </div>
            @if (hasError) {
                <div class="form-error">@_error</div>
            }
            <div class="form-actions">
                <button type="button" class="btn-main btn-cancel" @onclick="HandleClose" disabled="@_isSaving">Cancel
                </button>
                <button type="submit" class="btn-main btn-save" disabled="@_isSaving">Save</button>
            </div>
        </form>
    </div>
</Popup>

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public string Title { get; set; } = "Rename";
    [Parameter] public string? CurrentName { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<string> OnSave { get; set; }

    private string _name = "";
    private string _error = "";
    private bool _isSaving, _wasVisible;
    private bool hasError => !string.IsNullOrEmpty(_error);

    protected override void OnParametersSet() {
        if (IsVisible && !_wasVisible) {
            _name = CurrentName ?? "";
            _error = "";
        }

        _wasVisible = IsVisible;
    }

    private async Task HandleClose() {
        _error = "";
        await OnClose.InvokeAsync();
    }

    private async Task HandleSave() {
        var name = _name.Trim();
        if (name.Length < 2 || name.Length > 128) {
            _error = "Name must be between 2 and 128 characters.";
            return;
        }

        _isSaving = true;
        _error = "";
        try {
            await OnSave.InvokeAsync(name);
            await HandleClose();
        }
        catch (ApiException e) {
            _error = e.Message;
        }
        catch (HttpRequestException e) {
            _error = "Cannot reach the server. " + e.Message;
        }
        finally {
            _isSaving = false;
        }
    }

}