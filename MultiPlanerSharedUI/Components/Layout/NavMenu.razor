@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Routing
@using MultiPlanerSharedUI.Components.User
@inject AuthService Auth
@inject NavigationManager Nav

<button type="button" class="nav-user" aria-label="Account settings" @onclick="OpenUserSettingsPopup">
    <div class="user-img-div">
        <AvatarImage Url="@_avatar" Class="sidebar-avatar" />
    </div>
    <div class="nav-user-name nav-text">@_displayName</div>
</button>
<div class="nav-links">
    <div class="nav-items">
        <NavLink href="dashboard" class="nav-item" ActiveClass="nav-item-current" @onclick="OnNavigate">
            <img src="_content/MultiPlanerSharedUI/images/home.svg" alt="" class="nav-item-img">
            <div class="nav-text">Home</div>
        </NavLink>
        <NavLink href="rooms" class="nav-item" ActiveClass="nav-item-current" @onclick="OnNavigate">
            <img src="_content/MultiPlanerSharedUI/images/calendar.svg" alt="" class="nav-item-img">
            <div class="nav-text">Rooms</div>
        </NavLink>
        <NavLink href="events" class="nav-item" ActiveClass="nav-item-current" @onclick="OnNavigate">
            <img src="_content/MultiPlanerSharedUI/images/menu.svg" alt="" class="nav-item-img">
            <div class="nav-text">Events</div>
        </NavLink>
        <NavLink href="aboutauth" class="nav-item" ActiveClass="nav-item-current" @onclick="OnNavigate">
            <img src="_content/MultiPlanerSharedUI/images/info.svg" alt="" class="nav-item-img">
            <div class="nav-text">About</div>
        </NavLink>
    </div>
    <div class="nav-items">
        <button type="button" class="nav-item logout-btn" @onclick="LogoutAsync">
            <img src="_content/MultiPlanerSharedUI/images/power.svg" alt="" class="nav-item-img">
            <div class="nav-text">Logout</div>
        </button>
    </div>
</div>

@code {
    [Parameter] public EventCallback OnNavigate { get; set; }
    [Parameter] public EventCallback OnOpenSettings { get; set; }

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private string _displayName = "User";
    private string? _avatar;


    protected override async Task OnParametersSetAsync() {
        if (AuthState is not null) {
            var user = (await AuthState).User;
            var name = user.Identity?.Name;
            _avatar = user.FindFirst("avatar")?.Value;
            if (!string.IsNullOrWhiteSpace(name)) _displayName = name;
        }
    }

    private async Task OpenUserSettingsPopup() {
        await OnOpenSettings.InvokeAsync();
    }

    private async Task LogoutAsync() {
        await OnNavigate.InvokeAsync();
        await Auth.LogoutAsync();
        Nav.NavigateTo("/", replace: true);
    }

}
