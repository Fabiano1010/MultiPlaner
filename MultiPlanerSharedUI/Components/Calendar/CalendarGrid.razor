@using MultiPlanerSharedModels.Contracts.Events
<div class="calendar">
    <div class="calendar-day-name-container">
        @foreach (var day in _dayNames) {
            <div class="calendar-day-name">@day</div>
        }
    </div>
</div>
<div class="calendar-grid-wrapper">
    @foreach (var cell in _days) {
        var date = cell.Date;
        var dots = DotsFor(date);

        <div @key="date" class="@CellClass(cell)" @onclick="() => OnDayClicked.InvokeAsync(date)">
            <div class="day-number-div">
                <span class="day-number">@date.Day</span>
            </div>

            <div class="dots">
                @foreach (var dot in dots.Take(MaxDots)) {
                    <div class="event-dot @(dot.IsHighPriority ? "high" : "")"
                         style="background-color: #@dot.Color;"></div>
                }
                @if (dots.Count > MaxDots) {
                    <span class="dots-more">+@(dots.Count - MaxDots)</span>
                }
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public DateTime CurrentMonth { get; set; }
    [Parameter] public DateOnly? SelectedDate { get; set; }
    [Parameter] public DateOnly? RangeStart { get; set; }
    [Parameter] public DateOnly? RangeEnd { get; set; }
    [Parameter] public bool IsAddingEvent { get; set; }
    [Parameter] public IReadOnlyList<EventResponse> Events { get; set; } = Array.Empty<EventResponse>();
    [Parameter] public EventCallback<DateOnly> OnDayClicked { get; set; }

    private sealed record Cell(DateOnly Date, bool IsCurrentMonth);

    private record EventDot(string Color, bool IsHighPriority);

    private const int MaxDots = 6;

    private static readonly string[] _dayNames =
        { "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday" };

    private readonly List<Cell> _days = new();
    private DateOnly _generatedFor;
    private IReadOnlyList<EventResponse>? _eventsSeen;
    private Dictionary<DateOnly, List<EventDot>> _dots = new();

    protected override void OnParametersSet() {
        var month = new DateOnly(CurrentMonth.Year, CurrentMonth.Month, 1);
        var regenerated = month != _generatedFor;
        if (regenerated) {
            _generatedFor = month;
            GenerateDays(month);
        }

        if (regenerated || !ReferenceEquals(_eventsSeen, Events)) {
            _eventsSeen = Events;
            BuildDots();
        }
    }

    private void GenerateDays(DateOnly month) {
        _days.Clear();
        var (start, endExclusive) = CalendarRange.Grid(CurrentMonth);
        for (var d = start; d < endExclusive; d = d.AddDays(1))
            _days.Add(new Cell(d, d.Month == month.Month));
    }

    private void BuildDots() {
        var gridStart = _days[0].Date;
        var gridEnd = _days[^1].Date;
        var byDay = new Dictionary<DateOnly, List<EventResponse>>();

        foreach (var e in Events) {
            var (first, last) = EventDays.Range(e);
            var from = first < gridStart ? gridStart : first;
            var to = last > gridEnd ? gridEnd : last;

            for (var d = from; d <= to; d = d.AddDays(1)) {
                if (!byDay.TryGetValue(d, out var list)) byDay[d] = list = new List<EventResponse>();
                list.Add(e);
            }
        }

        _dots = byDay.ToDictionary(
            kv => kv.Key,
            kv => kv.Value
                .OrderByDescending(e => e.IsPinned)
                .ThenByDescending(e => e.IsHighPriority)
                .ThenBy(e => e.StartsAtUtc)
                .Select(e => new EventDot(e.Color, e.IsHighPriority))
                .ToList());
    }

    private IReadOnlyList<EventDot> DotsFor(DateOnly d) {
        return _dots.TryGetValue(d, out var list)
            ? list
            : Array.Empty<EventDot>();
    }

    private string CellClass(Cell c) {
        var d = c.Date;
        var isStart = RangeStart == d;
        var isEnd = RangeEnd == d;
        var inRange = RangeStart is { } s && RangeEnd is { } e && d > s && d < e;
        var selected = IsAddingEvent ? isStart || isEnd : SelectedDate == d;

        var cls = "calendar-cell";
        if (!c.IsCurrentMonth) cls += " other-month";
        if (selected) cls += " selected";
        if (inRange) cls += " in-range";
        if (isStart) cls += " range-start";
        if (isEnd) cls += " range-end";
        if (d.DayOfWeek == DayOfWeek.Sunday) cls += " sunday";
        if (d.DayOfWeek == DayOfWeek.Saturday) cls += " saturday";
        if (d == DateOnly.FromDateTime(DateTime.Today)) cls += " today";
        return cls;
    }

}