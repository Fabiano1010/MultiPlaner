@using MultiPlanerSharedModels.Services
@using MultiPlanerSharedModels.Models

<div class="calendar-grid-wrapper">

   
    @foreach (var day in _dayNames)
    {
        <div class="calendar-day-name">@day</div>
    }
    
    @foreach (var cell in _days)
    {
        <div class="calendar-cell
                    @(!cell.IsCurrentMonth ? "other-month" : "")
                    @(cell.IsSelected ? "selected" : "")
                    @(cell.IsInRange ? "in-range" : "")
                    @(cell.IsRangeStart ? "range-start" : "")
                    @(cell.IsRangeEnd ? "range-end" : "")
                    @(cell.IsSunday ? "sunday" : "")
                    @(cell.IsToday ? "today" : "")"
             @onclick="() => HandleDayClick(cell)">
            <div class="day-number-div">
                <span class="day-number">@cell.Day</span>
            </div>
           
            <div class="dots">
                @foreach (var color in cell.EventColors)
                {
                    <div class="event-dot" style="background-color: @color;"></div>
                }
            </div>

        </div>
    }

</div>

@code {
    [Parameter] public DateTime CurrentMonth { get; set; }
    [Parameter] public EventCallback<(DateTime, DateTime)> OnRangeSelected { get; set; }
    [Parameter] public EventCallback<DateTime> OnDaySelected { get; set; }
    [Parameter] public bool IsAddingEvent { get; set; }
    
    private DateTime _generatedFor;
    
    private readonly List<DayCell> _days = new();
    private DateTime? _rangeStart = null;

    private readonly string[] _dayNames = { "Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun" };

    protected override void OnParametersSet()
    {
        var month = new DateTime(CurrentMonth.Year, CurrentMonth.Month, 1);
        if (month == _generatedFor) return;
        _generatedFor = month;
        _rangeStart = null;
        GenerateDays();
    }
    

    private void GenerateDays()
    {
        _days.Clear();

        var firstDay = new DateTime(CurrentMonth.Year, CurrentMonth.Month, 1);
        var daysInMonth = DateTime.DaysInMonth(CurrentMonth.Year, CurrentMonth.Month);

        
        int startOffset = ((int)firstDay.DayOfWeek + 6) % 7;

       
        for (int i = 0; i < startOffset; i++)
        {
            var date = firstDay.AddDays(-(startOffset - i));
            _days.Add(new DayCell { Day = date.Day, Date = date, IsCurrentMonth = false, IsSunday = date.DayOfWeek == DayOfWeek.Sunday });
        }

        for (int i = 1; i <= daysInMonth; i++)
        {
            var date = new DateTime(CurrentMonth.Year, CurrentMonth.Month, i);
            _days.Add(new DayCell { Day = i, Date = date, IsCurrentMonth = true, IsSunday = date.DayOfWeek == DayOfWeek.Sunday });
        }

        while (_days.Count % 7 != 0)
        {
            var date = firstDay.AddDays(_days.Count - startOffset);
            _days.Add(new DayCell { Day = date.Day, Date = date, IsCurrentMonth = false, IsSunday = date.DayOfWeek == DayOfWeek.Sunday });
        }
      
      
        // var events = await EventApi.GetEventsAsync(CurrentMonth.Year, CurrentMonth.Month);
        // foreach (var cell in Days.Where(d => d.IsCurrentMonth))
        // {
        //     cell.EventColors = events
        //         .Where(e => cell.Date >= e.StartDate.Date && cell.Date <= e.EndDate.Date)
        //         .Select(e => $"#{e.Color}")  
        //         .ToList();
        // }
    }

    private async Task HandleDayClick(DayCell cell)
    {
        if (IsAddingEvent)
        {
            
            if (_rangeStart == null)
            {
                _rangeStart = cell.Date;
                foreach (var d in _days) { d.IsSelected = false; d.IsInRange = false; }
                cell.IsSelected = true;
            }
            else
            {
                var start = _rangeStart.Value < cell.Date ? _rangeStart.Value : cell.Date;
                var end = _rangeStart.Value < cell.Date ? cell.Date : _rangeStart.Value;
                foreach (var d in _days)
                {
                    d.IsRangeStart = d.Date == start;
                    d.IsRangeEnd = d.Date == end;
                    d.IsInRange = d.Date > start && d.Date < end;
                    d.IsSelected = d.IsRangeStart || d.IsRangeEnd;
                }
                _rangeStart = null;
                await OnRangeSelected.InvokeAsync((start, end));
            }
        }
        else
        {
           
            foreach (var d in _days) d.IsSelected = false;
            cell.IsSelected = true;
            await OnDaySelected.InvokeAsync(cell.Date);
        }
    }

    
}