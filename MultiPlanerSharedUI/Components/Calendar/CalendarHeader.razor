
@using Microsoft.JSInterop
@using MultiPlanerSharedModels.Contracts.Rooms
@using MultiPlanerSharedUI.Services
@inject ApiClient Api
@inject IJSRuntime JS
@implements IDisposable

<div class="header">
    <div class="date-controls-div">
        <button type="button" class="action-button goback-btn" title="Back" @onclick="OnBack">
            <img src="_content/MultiPlanerSharedUI/images/arrow-left.svg" alt="Back" class="action-button-img">
        </button>
        <div class="date-controls">
            <div class="date-controls-date">@CurrentMonth.Year</div>
            <div class="date-controls-date">@CurrentMonth.ToString("MMMM")</div>
        </div>
        <div class="date-move">
            <div class="action-button" @onclick="OnPreviousMonth"><img
                    src="_content/MultiPlanerSharedUI/images/chevron-left.svg" alt="" class="action-button-img"></div>
            <div class="date-controls-today " @onclick="GoToToday">
                Today
            </div>
            <div class="action-button" @onclick="OnNextMonth"><img
                    src="_content/MultiPlanerSharedUI/images/chevron-right.svg" alt="" class="action-button-img"></div>
        </div>
    </div>
    <div class="calendar-data">
        <div class="calendar-data-name">@Room.Name</div>
        <div class="calendar-data-owner">@Room.OwnerDisplayName</div>
    </div>
    <div class="action-buttons">
        @if (CanInvite) {
            <button type="button" class="action-button" aria-label="Copy invitation link"
                    title="Copy invitation link" disabled="@_copying" @onclick="CopyLinkAsync">
                <img src="_content/MultiPlanerSharedUI/images/link.svg" alt="" class="action-button-img">
            </button>
        }
        <button type="button" class="action-button" aria-label="Members" @onclick="OnOpenMembers">
            <img src="_content/MultiPlanerSharedUI/images/users.svg" alt="" class="action-button-img">
        </button>
        @if (CanEdit) {
            <button type="button" class="action-button" aria-label="Settings" @onclick="OnOpenSettings">
                <img src="_content/MultiPlanerSharedUI/images/settings.svg" alt="" class="action-button-img">
            </button>
        }
        <button type="button" class="action-button" aria-label="Notifications" @onclick="OnNotifications">
            <img src="_content/MultiPlanerSharedUI/images/@(NotificationsState ? "bell.svg" : "bell-off.svg")"
                 alt="" class="action-button-img bell-btn">
        </button>

        @if (_toast is not null) {
            <div class="header-toast @(_toastError ? "error" : "")" role="status">@_toast</div>
        }
    </div>

</div>

@code{
    [Parameter] [EditorRequired] public RoomResponse Room { get; set; } = default!;
    [Parameter] public DateTime CurrentMonth { get; set; }
    [Parameter] public EventCallback OnNextMonth { get; set; }
    [Parameter] public EventCallback OnPreviousMonth { get; set; }
    [Parameter] public EventCallback OnOpenSettings { get; set; }
    [Parameter] public EventCallback OnOpenMembers { get; set; }
    [Parameter] public EventCallback GoToToday { get; set; }
    [Parameter] public EventCallback OnBack { get; set; }
    [Parameter] public EventCallback OnNotifications { get; set; }
    [Parameter] public bool NotificationsState { get; set; }

    private bool _copying, _toastError;
    private string? _toast;
    private CancellationTokenSource? _toastCts;


    private bool CanInvite =>
        Room.ArchivedAtUtc is null
        && Room.ExpiresAtUtc > DateTimeOffset.UtcNow
        && (Room.IsOwner || Room.IsAdmin);

    private bool CanEdit =>
        Room.ArchivedAtUtc is null
        && Room.ExpiresAtUtc > DateTimeOffset.UtcNow
        && (Room.IsOwner || Room.IsAdmin);

    private async Task CopyLinkAsync() {
        if (_copying) return;
        _copying = true;

        try {
            var invitation = await GetCurrentInvitationAsync();

            if (invitation is null) {
                using var res = await Api.PostAsync($"api/rooms/{Room.Id}/invitations",
                    new CreateRoomInvitationRequest());
                await ApiClient.EnsureSuccessAsync(res);
                invitation = await GetCurrentInvitationAsync();
            }

            if (invitation is null) {
                ShowToast("Could not get the invitation link.", true);
                return;
            }

            await using var module = await JS.InvokeAsync<IJSObjectReference>(
                "import", "./_content/MultiPlanerSharedUI/js/settings.js");
            await module.InvokeVoidAsync("copyText", invitation.JoinUrl);

            ShowToast("Link copied.");
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException or JSException) {
            ShowToast(ex.Message, true);
        }
        finally {
            _copying = false;
        }
    }

    private async Task<RoomInvitationResponse?> GetCurrentInvitationAsync() {
        try {
            return await Api.GetAsync<RoomInvitationResponse>($"api/rooms/{Room.Id}/invitations/current");
        }
        catch (ApiException ex) when (ex.Status == 404) {
            return null;
        }
    }

    private void ShowToast(string text, bool error = false) {
        _toastCts?.Cancel();
        _toastCts?.Dispose();
        _toastCts = new CancellationTokenSource();
        var ct = _toastCts.Token;

        _toast = text;
        _toastError = error;
        _ = HideToastLaterAsync(ct);
    }

    private async Task HideToastLaterAsync(CancellationToken ct) {
        try {
            await Task.Delay(2500, ct);
        }
        catch (TaskCanceledException) {
            return;
        }

        _toast = null;
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose() {
        _toastCts?.Cancel();
        _toastCts?.Dispose();
    }

}
