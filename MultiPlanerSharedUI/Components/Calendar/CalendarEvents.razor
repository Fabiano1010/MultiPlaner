@using MultiPlanerSharedModels.Services
@using MultiPlanerSharedModels.Models
@using MultiPlanerSharedUI.Components.Events
@using MultiPlanerSharedUI.Components.Calendar
@using MultiPlanerSharedUI.Components.Layout

@inject EventService EventApi

<div class="events-container">
    <div class="events-controls">
        <div class="events-controls-div">
            <div class="events-control-date">
                Events @(SelectedDate.HasValue ? SelectedDate.Value.ToString("dd.MM.yyyy") : DateTime.Today.ToString("dd.MM.yyyy"))
            </div>
            <div class="events-buttons-container">
                <div class="events-button @(IsAddingEvent ? "active" : "")" 
                     @onclick="OnAddEvent">
                    <img src="/_content/MultiPlanerSharedUI/images/plus.svg" alt="" class="plus-icon @(IsAddingEvent ? "plus-icon-active" : "")">
                    <div class="events-button-name">Add Event</div>
                </div>
                <div class="events-button">
                    <img src="_content/MultiPlanerSharedUI/images/plus.svg" alt="" class="plus-icon">
                    <div class="events-button-name">Add Poll</div>
                </div>
            </div>
        </div>
        <div class="chat-btn action-button">
            <img src="_content/MultiPlanerSharedUI/images/message-square.svg" alt="" class="action-button-img">
        </div>
    </div>
    <div class="events-list">
        @if (Events.Count == 0)
        {
            <div class="events-empty">Nothing is happening here :c</div>
        }
        @foreach (var ev in Events)
        {
            <div class="events-item" 
                 style="border-left: 5px solid #@ev.Color"
                 @onclick="() => OpenDetails(ev)">
                <div class="events-item-name">@ev.Title</div>
                <div class="events-item-user">@ev.User</div>
                <div class="events-item-data">
                    @ev.StartDate.ToString("dd.MM.yyyy") - @ev.EndDate.ToString("dd.MM.yyyy")
                </div>
            </div>
        }
    </div>
</div>

<EventDetails IsVisible="ShowDetails"
                   Event="SelectedEvent"
                   OnClose="CloseDetails"
                   OnDeleted="HandleDeleted" />

@code {
    [Parameter] public DateTime CurrentMonth { get; set; }
    [Parameter] public DateTime? SelectedDate { get; set; }
    [Parameter] public EventCallback OnAddEvent { get; set; }
    [Parameter] public bool IsAddingEvent { get; set; }

    private List<Event> Events = new();
    private Event? SelectedEvent = null;
    private bool ShowDetails = false;

    protected override async Task OnParametersSetAsync()
    {
        await LoadEvents();
    }

    private async Task LoadEvents()
    {
        if (SelectedDate.HasValue)
            Events = await EventApi.GetEventsAtDayAsync(SelectedDate.Value);
        else
            Events = await EventApi.GetEventsAtDayAsync(DateTime.Today);
    }

    private void OpenDetails(Event ev)
    {
        SelectedEvent = ev;
        ShowDetails = true;
    }

    private void CloseDetails()
    {
        ShowDetails = false;
        SelectedEvent = null;
    }

    private async Task HandleDeleted()
    {
        await LoadEvents();
    }
}