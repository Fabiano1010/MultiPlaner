@using MultiPlanerSharedModels.Contracts.Events
@using MultiPlanerSharedUI.Components.Events
<div class="events-container">
    <div class="events-controls">
        <button type="button" class="action-button events-toggle"
                aria-expanded="@(!_collapsed)"
                title="@(_collapsed ? "Show events" : "Hide events")"
                @onclick="ToggleCollapsed">
            <img src="_content/MultiPlanerSharedUI/images/chevron-left.svg" alt=""
                 class="action-button-img events-toggle-icon @(_collapsed ? "up" : "down")">
        </button>
        <div class="events-controls-div">
            <div class="events-control-date">
                Events @(SelectedDate.HasValue ? SelectedDate.Value.ToString("dd.MM.yyyy") : DateTime.Today.ToString("dd.MM.yyyy"))
            </div>
            <div class="events-buttons-container">
                <div class="events-button @(IsAddingEvent ? "active" : "")"
                     @onclick="OnAddEvent">
                    <img src="/_content/MultiPlanerSharedUI/images/plus.svg" alt=""
                         class="plus-icon @(IsAddingEvent ? "plus-icon-active" : "")">
                    <div class="events-button-name">Add Event</div>
                </div>
                <div class="events-button">
                    <img src="_content/MultiPlanerSharedUI/images/plus.svg" alt="" class="plus-icon">
                    <div class="events-button-name">Add Poll</div>
                </div>
            </div>
        </div>
        <div class="chat-btn action-button">
            <img src="_content/MultiPlanerSharedUI/images/message-square.svg" alt="" class="action-button-img">
        </div>
    </div>
    <div class="events-collapse @(_collapsed ? "collapsed" : "")">
        <div class="events-collapse-inner">
            <div class="events-list-cointainer">

                @if (_dayEvents.Count == 0) {
                    <div class="events-empty">Nothing is happening here :c</div>
                }
                else {
                    <div class="events-list">
                        @foreach (var ev in _dayEvents) {
                            <div class="events-item @(ev.IsHighPriority ? "high" : "")" @key="ev.Id"
                                 style="border-left: 5px solid #@ev.Color; border-right: 5px solid #@ev.Color"
                                 @onclick="() => OpenDetails(ev)">
                                <div class="events-item-details">
                                    <div class="events-item-name">@(ev.IsPinned ? "x" : "")@ev.Title</div>
                                    <div class="events-item-user">@ev.Author.DisplayName</div>
                                </div>

                                @{ var span = EventDays.Span(ev); }
                                <div class="events-item-date">
                                    @span.StartDate.ToString("dd.MM.yyyy") - @span.EndDate.ToString("dd.MM.yyyy")
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

        </div>
    </div>
</div>

<EventDetails IsVisible="_showDetails"
              Event="_selectedEvent"
              OnClose="HandleCloseDetails"
              OnChanged="OnChanged"
              RoomId="RoomId"
/>

@code {
    [Parameter] public DateTime CurrentMonth { get; set; }
    [Parameter] public DateOnly? SelectedDate { get; set; }
    [Parameter] public EventCallback OnAddEvent { get; set; }
    [Parameter] public EventCallback<bool> OnCollapsedChanged { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }
    [Parameter] public bool IsAddingEvent { get; set; }
    [Parameter] public IReadOnlyList<EventResponse> Events { get; set; } = Array.Empty<EventResponse>();
    [Parameter] public int RoomId { get; set; }

    private EventResponse? _selectedEvent;
    private bool _showDetails;
    private IReadOnlyList<EventResponse>? _eventsSeen;
    private DateOnly? _daySeen;
    private List<EventResponse> _dayEvents = new();
    private bool _collapsed = true;


    private async Task ToggleCollapsed() {
        _collapsed = !_collapsed;
        await OnCollapsedChanged.InvokeAsync(_collapsed);
    }

    protected override void OnParametersSet() {
        var day = SelectedDate ?? DateOnly.FromDateTime(DateTime.Today);
        if (ReferenceEquals(_eventsSeen, Events) && _daySeen == day) return;

        _eventsSeen = Events;
        _daySeen = day;
        _dayEvents = Events
            .Where(e => {
                var (f, l) = EventDays.Range(e);
                return f <= day && day <= l;
            })
            .OrderByDescending(e => e.IsPinned)
            .ThenByDescending(e => e.IsAllDay)
            .ThenBy(e => e.StartsAtUtc)
            .ToList();
    }

    private void OpenDetails(EventResponse ev) {
        _selectedEvent = ev;
        _showDetails = true;
    }


    private void HandleCloseDetails() {
        _showDetails = false;
        _selectedEvent = null;
    }


}