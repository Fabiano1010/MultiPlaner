@using MultiPlanerSharedModels.Contracts.Common
@using MultiPlanerSharedModels.Contracts.Polls
@using MultiPlanerSharedModels.Contracts.Rooms
@inject ApiClient Api

<Popup Title="@(_form ? _editing is null ? "New poll" : "Edit poll" : "Polls")"
       IsVisible="IsVisible" OnClose="HandleClose" IsLarge="true">
    <div class="polls-container">
        @if (_form) {
            <AddPoll Room="Room" Existing="_editing" OnBack="BackToList" OnSaved="HandleSaved"/>
        }
        else if (Opened is { } open) {
            <div class="poll-detail-top">
                <button type="button" class="action-button goback-btn" title="Back" @onclick="CloseDetail">
                    <img src="_content/MultiPlanerSharedUI/images/arrow-left.svg" alt="Back" class="action-button-img">
                </button>
            </div>

            <Poll Data="open" RoomId="Room.Id" TimeZoneId="@Room.TimeZoneId"
                  OnChanged="HandleChanged" OnDeleted="HandleDeleted"
                  OnEdit="StartEdit" OnReload="LoadAsync"/>
        }
        else {
            <div class="polls-header">
                <select class="input-main polls-filter" value="@_status" @onchange="OnStatusChanged">
                    <option value="open">Open</option>
                    <option value="closed">Closed</option>
                    <option value="all">All</option>
                </select>

                @if (Active) {
                    <button type="button" class="events-button" @onclick="StartAdd">
                        <img src="_content/MultiPlanerSharedUI/images/plus.svg" alt="" class="plus-icon">
                        <span class="polls-header-add-text">Add poll</span>
                    </button>
                }
            </div>

            @if (_loading) {
                <LoadingSpinner/>
            }
            else if (_error is not null) {
                <div class="form-error">@_error</div>
                <button type="button" class="btn-main btn-cancel" @onclick="LoadAsync">Retry</button>
            }
            else {
                <PollsList Polls="_polls" TimeZoneId="@Room.TimeZoneId" OnOpen="OpenPoll" />
            }
        }
    </div>
</Popup>

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] [EditorRequired] public RoomResponse Room { get; set; } = default!;
    [Parameter] public EventCallback OnClose { get; set; }

    private List<PollResponse> _polls = new();
    private PollResponse? _editing;
    private string _status = "open";
    private string? _error;
    private bool _loading, _form, _wasVisible;
    private int? _openId;

    private PollResponse? Opened => _openId is { } id ? _polls.FirstOrDefault(p => p.Id == id) : null;

    private bool Active => Room.ArchivedAtUtc is null && Room.ExpiresAtUtc > DateTimeOffset.UtcNow;

    private void OpenPoll(int id) {
        _openId = id;
    }

    private void CloseDetail() {
        _openId = null;
    }

    protected override async Task OnParametersSetAsync() {
        if (IsVisible && !_wasVisible) {
            _form = false;
            _editing = null;
            _openId = null;
            await LoadAsync();
        }

        _wasVisible = IsVisible;
    }

    private async Task LoadAsync() {
        _loading = true;
        _error = null;
        try {
            var all = new List<PollResponse>();
            for (var page = 1;; page++) {
                var res = await Api.GetAsync<PagedResponse<PollResponse>>(
                    $"api/rooms/{Room.Id}/polls?status={_status}&page={page}&pageSize=100");
                if (res is null || res.Items.Count == 0) break;
                all.AddRange(res.Items);
                if (all.Count >= res.TotalCount) break;
            }

            _polls = all;
        }
        catch (ApiException e) {
            _error = e.Message;
        }
        catch (HttpRequestException e) {
            _error = "Cannot load polls. " + e.Message;
        }
        finally {
            _loading = false;
        }
    }

    private async Task OnStatusChanged(ChangeEventArgs e) {
        _status = e.Value?.ToString() ?? "open";
        await LoadAsync();
    }

    private void StartAdd() {
        _editing = null;
        _form = true;
    }

    private void StartEdit(PollResponse poll) {
        _editing = poll;
        _form = true;
    }

    private void BackToList() {
        _form = false;
        _editing = null;
    }

    private async Task HandleSaved() {
        BackToList();
        await LoadAsync();
    }


    private void HandleChanged(PollResponse updated) {
        _polls = _polls.Select(p => p.Id == updated.Id ? updated : p).ToList();
    }

    private void HandleDeleted(int id) {
        _polls = _polls.Where(p => p.Id != id).ToList();
        _openId = null;
    }


    private async Task HandleClose() {
        if (_form) {
            BackToList();
            return;
        }

        if (_openId is not null) {
            CloseDetail();
            return;
        }

        await OnClose.InvokeAsync();
    }

}