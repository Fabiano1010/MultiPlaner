<Popup Title="Polls" IsVisible="IsVisible" OnClose="OnClose">

    <div class="polls-container">
        @* @if (_loading) { *@
        @*     <LoadingSpinner /> *@
        @* } *@
        @* else { *@
            @if (_addPoll) {
                <AddPoll OnClose="() => _addPoll = false"/>
            }
            else {
                <div class="polls-header">
                    <div class="polls-header-title">Polls</div>
                    <button class="polls-header-add" @onclick="_ => _addPoll = true">
                        <img src="/_content/MultiPlanerSharedUI/images/plus.svg" alt="" class="plus-icon">
                        <div class="polls-header-add-text">Add Poll</div>
                    </button>
                </div>
                <PollsList/>
            }    
        @* } *@
        





    </div>
    
</Popup>
@code {
    
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }


    private bool _addPoll;
    private bool _loading = true;
}