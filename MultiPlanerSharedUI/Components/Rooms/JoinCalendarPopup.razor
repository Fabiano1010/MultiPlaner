@using MultiPlanerSharedModels.Contracts.Rooms
@inject ApiClient Api
@inject NavigationManager Nav

<Popup IsVisible="IsVisible" Title="Join calendar" OnClose="@HandleCloseAsync">

    <div class="add-room-form-box">
        <form class="add-room-form" @onsubmit="HandleJoinAsync" @onsubmit:preventDefault>
            <div class="form-group">
                <label>Calendar link</label>
                <input type="text" @bind="_calendarLink" placeholder="Calendar link"
                       class="input-main @(HasError ? "error-input" : "")"/>
            </div>
            @if (!string.IsNullOrEmpty(_errorMessage)) {
                <div class="form-error">@_errorMessage</div>
            }
            <div class="form-actions">
                <button class="btn-main btn-cancel" @onclick="HandleCloseAsync" disabled="@_isJoining">Cancel</button>
                <button class="btn-main btn-save" type="submit" disabled="@_isJoining">Join</button>
            </div>

        </form>
    </div>


</Popup>


@code {
    [Parameter] public bool IsVisible { get; set; }

    [Parameter] public EventCallback OnClose { get; set; }

    [Parameter] public EventCallback<RoomResponse> OnJoin { get; set; }

    private string _calendarLink = "";

    private string _errorMessage = "";
    private bool _isJoining;
    private bool HasError => !string.IsNullOrEmpty(_errorMessage);


    private async Task HandleCloseAsync() {
        _errorMessage = "";
        await OnClose.InvokeAsync();
    }

    private async Task HandleJoinAsync() {
        var link = _calendarLink?.Trim() ?? string.Empty;
        if (link.Length is < 2 or > 256) {
            _errorMessage = "Calendar link must be between 2 and 256 characters.";
            return;
        }
    
        _isJoining = true;
        _errorMessage = "";
    
        try {
            if(!Uri.TryCreate(link, UriKind.Absolute, out var uri) || uri.Scheme != Uri.UriSchemeHttps) {
                _errorMessage = "Invalid calendar link. Please provide a valid HTTPS URL.";
                return;
            }
            var token = link.Split("/").LastOrDefault() ?? "";
            Nav.NavigateTo($"/join/{token}");
            await HandleCloseAsync();
        }
        catch (ApiException e) {
            _errorMessage = e.Message;
        }
        catch (HttpRequestException e) {
            _errorMessage = "Cannot reach the server. " + e.Message;
        }
        finally {
            _isJoining = false;
            _calendarLink = "";
        }
    }

}