@using System.Net.Http.Json
@using MultiPlanerSharedModels.Contracts.Rooms
@inject HttpClient Http

<div class="hide-folders-box">
    <div class="action-button hide-folders">
        <div class="toggle-btn @(_areFoldersHidden ? "up" : "down")"
             aria-expanded="@(!_areFoldersHidden)"
             title="@(_areFoldersHidden ? "Show folders" : "Hide folders")"
             @onclick="HideFoldersAsync">
            <img src="_content/MultiPlanerSharedUI/images/arrow-up-left.svg"
                 alt=""/>
        </div>

    </div>
    <span>@(_areFoldersHidden ? "Show folders" : "Hide folders")</span>
</div>


<div class="folders-collapse @(_areFoldersHidden ? "collapsed" : "")">
    <div class="folders-collapse-inner">
        <div class="folders-container">
            @if (_isLoading) {
                <LoadingSpinner/>
            }
            else if (!string.IsNullOrEmpty(_errorMessage)) {
                <div class="error-message">@_errorMessage</div>
            }
            else if (_folders is not null && _folders.Count > 0) {
                foreach (var folder in _folders.OrderByDescending(f => f.IsFavourite)) {
                    <Folder @key="folder.Id" FolderData="folder"
                            OnConflict="() => LoadFoldersAsync()"
                            OnFavouriteChanged="() => LoadFoldersAsync(true)"
                            OnChanged="() => LoadFoldersAsync(true)"/>
                }
            }
            else {
                <div class="no-folders-message">Hey add some folders!</div>
            }
        </div>
    </div>
</div>

@code {
    private bool _isLoading = true;
    private string? _errorMessage;
    private List<UserFolderResponse>? _folders = new();

    private bool _areFoldersHidden;
    private async Task HideFoldersAsync() {
        _areFoldersHidden = !_areFoldersHidden;
    }

    protected override async Task OnInitializedAsync() {
        await LoadFoldersAsync();
    }

    public async Task LoadFoldersAsync(bool silent = false) {
        if (!silent) _isLoading = true;
        _errorMessage = null;

        try {
            var result = await Http.GetFromJsonAsync<List<UserFolderResponse>>("api/me/folders");
            _folders = result ?? new List<UserFolderResponse>();
        }
        catch (HttpRequestException e) {
            _errorMessage = "Cannot load folders. " + e.Message;
        }
        finally {
            _isLoading = false;
            StateHasChanged();
        }
    }


}