@using System.Net.Http.Json
@using MultiPlanerSharedModels.Contracts.Rooms
@using MultiPlanerSharedUI.Components.Layout
@inject HttpClient Http
@inject ApiClient Api

<div class="room" style="background-color: @_background" @oncontextmenu="e => _menu?.Show(e)" @oncontextmenu:preventDefault>
    <div class="room-header">
        @(RoomData?.Name ?? "Room Name")
    </div>
    <div class="room-body">
        <div class="room-content">
            <img src="@(_imagePath ?? "_content/MultiPlanerSharedUI/images/calendar.svg")"
                 alt="room image"
                 class="room-image" />
        </div>
    </div>
    <div class="room-footer">
        <button type="button" class="favourite-btn" title="Menu" @onclick="e => _menu?.Show(e)" @onclick:stopPropagation>
            <img src="_content/MultiPlanerSharedUI/images/menu.svg" alt="menu" class="favourite-icon" />
        </button>
        <span>@RoomData?.OwnerDisplayName</span>
        <button type="button" class="favourite-btn"
                aria-pressed="@_isFavourite"
                disabled="@_isSaving"
                title="@(_isFavourite ? "Remove from favourites" : "Add to favourites")"
                @onclick="ToggleFavouriteAsync">
            <img src="_content/MultiPlanerSharedUI/images/@(_isFavourite ? "heart-filled.svg" : "heart-outlined.svg")"
                 alt="" class="favourite-icon" />
        </button>
    </div>
</div>

<ContextMenu @ref="_menu">
    @if (RoomData?.IsOwner == true)
    {
        <button class="ctx-item" @onclick="StartRename">Rename</button>
        <button class="ctx-item danger" @onclick="StartDelete">Delete</button>
    }
    else
    {
        <button class="ctx-item danger" @onclick="StartLeave">Leave</button>
    }
    
</ContextMenu>

<RenamePopup IsVisible="_showRename" Title="Rename calendar"
             CurrentName="@RoomData?.Name"
             OnSave="RenameAsync" OnClose="() => _showRename = false" />

<ConfirmPopup IsVisible="_showDelete" Title="Delete calendar" Danger="true" ConfirmText="Delete"
              Message="@($"Delete \"{RoomData?.Name}\" for everyone? This cannot be undone.")"
              OnConfirm="DeleteAsync" OnClose="() => _showDelete = false" />

<ConfirmPopup IsVisible="_showLeave" Title="Leave calendar" Danger="true" ConfirmText="Leave"
              Message="@($"Leave \"{RoomData?.Name}\"?")"
              OnConfirm="LeaveAsync" OnClose="() => _showLeave = false" />

@code {
    [Parameter] 
    public  RoomResponse? RoomData { get; set; }
    [Parameter] 
    public EventCallback OnConflict { get; set; }
    [Parameter] 
    public EventCallback OnFavouriteChanged { get; set; }
    [Parameter] 
    public EventCallback OnChanged { get; set; } 
    

    
    private bool _isFavourite;
    private bool _isSaving;
    private byte[]? _rowVersion;
    public string? _imagePath;
    private ContextMenu? _menu;
    private bool _menuOpen, _showRename, _showDelete, _showLeave;
    
    private string _background => 
        string.IsNullOrWhiteSpace(RoomData?.Membership?.Color)
            ? "var(--color-primary-dim-light)"
            :"#" + RoomData!.Membership!.Color;
  
    
    protected override void OnParametersSet() {
        _isFavourite = RoomData?.Membership?.IsFavourite ?? false;
        _rowVersion = RoomData?.Membership?.RowVersion;
    }
    private void StartRename() { _menu?.Hide(); _showRename = true; }
    private void StartDelete() { _menu?.Hide(); _showDelete = true; }
    private void StartLeave()  { _menu?.Hide(); _showLeave = true; }


    private async Task ToggleFavouriteAsync() {
        if (RoomData is null || _isSaving) return;
        var newValue = !_isFavourite;
        _isFavourite = newValue;
        _isSaving = true;
        try {
            var res = await Api.PatchAsync($"api/rooms/{RoomData.Id}/members/me", new { isFavourite = newValue, rowVersion = _rowVersion });
            if (res.StatusCode == System.Net.HttpStatusCode.Conflict) {
                _isFavourite = !newValue;
                await OnConflict.InvokeAsync();
                return;
            }

            await ApiClient.EnsureSuccessAsync(res);
            var updated = await res.Content.ReadFromJsonAsync<RoomResponse>();
            if (updated is not null) {
                _rowVersion = updated.Membership?.RowVersion;
            }

            await OnFavouriteChanged.InvokeAsync();
        }
        catch (Exception ex) {
            _isFavourite = !newValue;
            Console.WriteLine($"Error toggling favourite: {ex.Message}");
        }
        finally {
            _isSaving = false;
        }
    }

    private async Task RenameAsync(string name)
    {
        if (RoomData is null) return;

        var res = await Api.PatchAsync($"api/rooms/{RoomData.Id}",
            new { name, rowVersion = RoomData.RowVersion });   // wersja POKOJU, nie członkostwa
        await ApiClient.EnsureSuccessAsync(res);

        await OnChanged.InvokeAsync();
    }

    private async Task DeleteAsync()
    {
        if (RoomData is null) return;

        var res = await Api.SendAsync(HttpMethod.Delete, $"api/rooms/{RoomData.Id}");
        await ApiClient.EnsureSuccessAsync(res);

        await OnChanged.InvokeAsync();
    }

    private async Task LeaveAsync()
    {
        if (RoomData is null) return;

        var res = await Api.SendAsync(HttpMethod.Delete, $"api/rooms/{RoomData.Id}/members/me");
        await ApiClient.EnsureSuccessAsync(res);

        await OnChanged.InvokeAsync();
    }
}