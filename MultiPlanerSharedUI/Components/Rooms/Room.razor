@using System.Net.Http.Json
@using MultiPlanerSharedModels.Contracts.Rooms
@using MultiPlanerSharedUI.Components.Layout
@inject HttpClient Http

<div class="room">
    <div class="room-header">
        @(RoomData.Name ?? "Room Name")
    </div>
    <div class="room-body">
        <div class="room-content">
            <img src="@(imagePath ?? "_content/MultiPlanerSharedUI/images/calendar.svg")"
                 alt="room image"
                 class="room-image" />
        </div>
    </div>
    <div class="room-footer">
       
        <img src="_content/MultiPlanerSharedUI/images/menu.svg" alt="menu" class="folder-menu-icon">
        <span>@(RoomData.OwnerDisplayName)</span>
        <img src="_content/MultiPlanerSharedUI/images/@(_isFavourite ? "heart-filled.svg" : "heart-outlined.svg")"
             alt="favourite"
             class="favourite-icon"
             @onclick="ToggleFavourite">
    </div>
</div>
@code {
    [Parameter] 
    public RoomResponse? RoomData { get; set; }
    
    private bool _isFavourite;
    private void ToggleFavourite() => _isFavourite = !_isFavourite;
    private string? imagePath = null;
    
    
    
}