@using System.Net.Http.Json
@using MultiPlanerSharedModels.Contracts.Rooms
@using MultiPlanerSharedUI.Components.Layout
@inject HttpClient Http
@inject ApiClient Api

<div class="folder" @oncontextmenu="e => _menu?.Show(e)" @oncontextmenu:preventDefault>
    <div class="folder-header">
            
    </div>
    <div class="folder-body">
        <div class="folder-content">
            @FolderData?.Name
        </div>
    </div>
    <div class="folder-footer">
        <button type="button" class="favourite-btn" title="Menu" @onclick="e => _menu?.Show(e)" @onclick:stopPropagation>
            <img src="_content/MultiPlanerSharedUI/images/menu.svg" alt="menu" class="favourite-icon" />
        </button>
        <button type="button" class="favourite-btn"
                aria-pressed="@_isFavourite"
                disabled="@_isSaving"
                title="@(_isFavourite ? "Remove from favourites" : "Add to favourites")"
                @onclick="ToggleFavouriteAsync">
            <img src="_content/MultiPlanerSharedUI/images/@(_isFavourite ? "heart-filled.svg" : "heart-outlined.svg")"
                 alt="" class="favourite-icon" />
        </button>
    </div>
</div>

<ContextMenu @ref="_menu">
    <button class="ctx-item" @onclick="StartRename">Rename</button>
    <button class="ctx-item danger" @onclick="StartDelete">Delete</button>

    
</ContextMenu>

<RenamePopup IsVisible="_showRename" Title="Rename folder"
             CurrentName="@FolderData?.Name"
             OnSave="RenameAsync" OnClose="() => _showRename = false" />

<ConfirmPopup IsVisible="_showDelete" Title="Delete folder" Danger="true" ConfirmText="Delete"
              Message="@($"Delete folder \"{FolderData?.Name}\"? Calendars inside will not be deleted.")"
              OnConfirm="DeleteAsync" OnClose="() => _showDelete = false" />

@code {
    [Parameter] public UserFolderResponse? FolderData { get; set; }
    [Parameter] 
    public EventCallback OnChanged { get; set; }
    [Parameter] 
    public EventCallback OnConflict { get; set; }
    [Parameter] 
    public EventCallback OnFavouriteChanged { get; set; }
    
    private bool _isFavourite;
    private bool _isSaving;
    private byte[]? _rowVersion;
    private bool _menuOpen, _showRename, _showDelete;
    private ContextMenu? _menu;
    
    // private string _background => 
    //     string.IsNullOrWhiteSpace(FolderData?.Color)
    //         ? "var(--color-primary-dim-light)"
    //         :"#" + FolderData!.Color;
    //
    
    protected override void OnParametersSet() {
        _isFavourite = FolderData?.IsFavourite ?? false;
        _rowVersion = FolderData?.RowVersion;
    }
    
    private void StartRename() { _menuOpen = false; _showRename = true; }
    private void StartDelete() { _menuOpen = false; _showDelete = true; }
    
    private async Task ToggleFavouriteAsync() {
        if (FolderData is null || _isSaving) return;
        var newValue = !_isFavourite;
        _isFavourite = newValue;
        _isSaving = true;
        try {
            var res = await Api.PatchAsync($"api/me/folders/{FolderData!.Id}", new { isFavourite = newValue, rowVersion = _rowVersion });
            if (res.StatusCode == System.Net.HttpStatusCode.Conflict) {
                _isFavourite = !newValue;
                await OnConflict.InvokeAsync();
                return;
            }

            await ApiClient.EnsureSuccessAsync(res);
            var updated = await res.Content.ReadFromJsonAsync<RoomResponse>();
            if (updated is not null) {
                _rowVersion = updated.Membership?.RowVersion;
            }

            await OnFavouriteChanged.InvokeAsync();
        }
        catch (Exception ex) {
            _isFavourite = !newValue;
            Console.WriteLine($"Error toggling favourite: {ex.Message}");
        }
        finally {
            _isSaving = false;
        }
    }
    private async Task RenameAsync(string name)
    {
        if (FolderData is null) return;
        var res = await Api.PatchAsync($"api/me/folders/{FolderData.Id}",
            new { name, rowVersion = _rowVersion });
        await ApiClient.EnsureSuccessAsync(res);
        await OnChanged.InvokeAsync();
    }

    private async Task DeleteAsync()
    {
        if (FolderData is null) return;
        var res = await Api.SendAsync(HttpMethod.Delete, $"api/me/folders/{FolderData.Id}");
        await ApiClient.EnsureSuccessAsync(res);
        await OnChanged.InvokeAsync();
    }

}