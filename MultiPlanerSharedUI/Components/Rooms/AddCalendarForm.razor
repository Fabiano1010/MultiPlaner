@using MultiPlanerSharedModels.Contracts.Rooms
@using System.Net.Http.Json
@inject ApiClient Api

<Popup IsVisible="IsVisible" Title="Add new calendar" OnClose="@HandleCloseAsync">
    
    <div class="add-room-form-box">
        <form class="add-room-form" @onsubmit="HandleSaveAsync" @onsubmit:preventDefault> 
            <div class="form-group">
                <label>Calendar name</label>
                <input type="text" @bind="_calendarName" placeholder="Calendar name" class="input-main @(HasError ? "error-input" : "")"/>
            </div>
            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <div class="form-error">@_errorMessage</div>
            }
            <div class="form-actions">
                <button class="btn-main btn-cancel" @onclick="HandleCloseAsync" disabled="@_isSaving">Cancel</button>
                <button class="btn-main btn-save" type="submit" disabled="@_isSaving">Save</button>
            </div>

        </form>
    </div>
    
    
</Popup>


@code {
    [Parameter] public bool IsVisible { get; set; }
    
    [Parameter] public EventCallback OnClose { get; set; }
    
    [Parameter] public EventCallback<RoomResponse> OnCreate { get; set; }

    private string _calendarName = "New Calendar";

    private string _errorMessage = "";
    private bool _isSaving;
    private bool HasError => !string.IsNullOrEmpty(_errorMessage);
    
    
    private async Task HandleCloseAsync() {
        _errorMessage = "";
        await OnClose.InvokeAsync();
    }

    private async Task HandleSaveAsync() {
        var name = _calendarName?.Trim() ?? string.Empty;
        if (name.Length is < 2 or > 128) {
            _errorMessage = "Calendar name must be between 2 and 128 characters.";
            return;
        }

        _isSaving = true;
        _errorMessage = "";

        try {
            var request = new CreateRoomRequest() { Name = name };
            var response = await Api.PostAsync("api/rooms", request);
            await ApiClient.EnsureSuccessAsync(response);
            if (!response.IsSuccessStatusCode) {
                var body = await response.Content.ReadAsStringAsync();
                _errorMessage = $"Error creating room: {response.StatusCode} - {body}";
                return;
            }
            var room = await response.Content.ReadFromJsonAsync<RoomResponse>();
            await OnCreate.InvokeAsync(room!);
            await HandleCloseAsync();
        }
        catch (ApiException e) {
            _errorMessage = e.Message;
        }
        catch (HttpRequestException e) {
            _errorMessage = "Cannot reach the server. " + e.Message;
        }
        finally {
            _isSaving = false;
            _calendarName = "New Calendar";
        }
    }
}