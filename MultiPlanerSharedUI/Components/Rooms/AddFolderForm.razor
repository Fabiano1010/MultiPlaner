@using MultiPlanerSharedModels.Contracts.Rooms
@using System.Net.Http.Json
@inject ApiClient Api

<Popup IsVisible="IsVisible" Title="Add new folder" OnClose="HandleClose">
    
    <div class="add-room-form-box">
        <form class="add-room-form" @onsubmit="HandleSave" @onsubmit:preventDefault> 
            <div class="form-group">
                <label>Folder name</label>
                <input type="text" @bind="_folderName" placeholder="Folder name" class="input-main @(HasError ? "error-input" : "")"/>
            </div>
            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <div class="form-error">@_errorMessage</div>
            }
            <div class="form-actions">
                <button class="btn-main btn-cancel" @onclick="HandleClose" disabled="@_isSaving">Cancel</button>
                <button class="btn-main btn-save" disabled="@_isSaving">Save</button>
            </div>

        </form >
    </div>
    
    
</Popup>


@code {
    [Parameter] public bool IsVisible { get; set; }

    [Parameter] public EventCallback OnClose { get; set; }

    [Parameter] public EventCallback<RoomResponse> OnCreate { get; set; }

    private string _folderName = "New Folder";

    private string _errorMessage = "";
    private bool _isSaving;
    private bool HasError => !string.IsNullOrEmpty(_errorMessage);

    private async Task HandleClose() {
        _errorMessage = "";
        await OnClose.InvokeAsync();
    }

    private async Task HandleSave() {
        var name = _folderName?.Trim() ?? string.Empty;
        if (name.Length is < 2 or > 128) {
            _errorMessage = "Folder name must be between 2 and 128 characters.";
            return;
        }

        _isSaving = true;
        _errorMessage = "";

        try {
            var request = new CreateUserFolderRequest() { Name = name };
            var response = await Api.PostAsync("api/me/folders", request);
            await ApiClient.EnsureSuccessAsync(response);
            if (!response.IsSuccessStatusCode) {
                var body = await response.Content.ReadAsStringAsync();
                _errorMessage = $"Error creating room: {response.StatusCode} - {body}";
                return;
            }
            var room = await response.Content.ReadFromJsonAsync<RoomResponse>();
            await OnCreate.InvokeAsync(room!);
            await HandleClose();
        }
        catch (ApiException e) {
            _errorMessage = e.Message;
        }
        catch (HttpRequestException e) {
            _errorMessage = "Cannot reach the server. " + e.Message;
        }
        finally {
            _isSaving = false;
            _folderName = "New Folder";
        }
        
    }

}