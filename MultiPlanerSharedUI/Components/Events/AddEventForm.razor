@using MultiPlanerSharedModels.Contracts.Events
@inject ApiClient Api

<Popup IsVisible="IsVisible" Title="Add event" OnClose="HandleClose">
    <form class="add-event-form" @onsubmit="SaveAsync" @onsubmit:preventDefault>
        <div class="form-group">
            <label>Event name</label>
            <input type="text" class="input-main" @bind="_title" @bind:event="oninput" maxlength="128"/>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label>Start</label>
                <input type="date" class="input-main" @bind="_start"/>
            </div>
            <div class="form-group">
                <label>End</label>
                <input type="date" class="input-main" @bind="_end"/>
            </div>
        </div>

        <div class="form-group form-group-checkbox">
            <label><input type="checkbox" @bind="_allDay"/> All day</label>
        </div>

        @if (!_allDay) {
            <div class="form-row">
                <div class="form-group"><label>From</label><input type="time" class="input-main" @bind="_startTime"/>
                </div>
                <div class="form-group"><label>To</label><input type="time" class="input-main" @bind="_endTime"/></div>
            </div>
        }

        <div class="form-row">
            <div class="form-group">
                <label>Category</label>
                <select class="input-main" @bind="_category">
                    @foreach (var c in Enum.GetValues<EventCategory>()) {
                        <option value="@c">@c</option>
                    }
                </select>
            </div>
            <div class="form-group form-group-color">
                <label>Color</label>
                <input type="color" @bind="_color" disabled="@_defaultColor"/>
                <label class="inline"><input type="checkbox" @bind="_defaultColor"/> Default</label>
            </div>
        </div>

        <div class="form-group">
            <label>Description</label>
            <textarea class="input-main" @bind="_description" rows="3" maxlength="4000"></textarea>
        </div>

        <div class="form-group form-group-checkbox">
            <label><input type="checkbox" @bind="_highPriority"/> High priority</label>
        </div>

        @if (!string.IsNullOrEmpty(_error)) {
            <div class="form-error">@_error</div>
        }

        <div class="form-actions">
            <button type="button" class="btn-main btn-cancel" @onclick="HandleClose" disabled="@_isSaving">Cancel
            </button>
            <button type="submit" class="btn-main btn-save" disabled="@_isSaving">Save</button>
        </div>
    </form>
</Popup>

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public int RoomId { get; set; }
    [Parameter] public string RoomTimeZoneId { get; set; } = "UTC";
    [Parameter] public DateOnly Start { get; set; }
    [Parameter] public DateOnly End { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }

    private string _title = "", _description = "", _color = "#999999", _error = "";
    private DateOnly _start, _end;
    private TimeOnly _startTime = new(9, 0), _endTime = new(10, 0);
    private bool _allDay = true, _highPriority, _defaultColor = true, _isSaving, _wasVisible;
    private EventCategory _category = EventCategory.Meeting;

    protected override void OnParametersSet() {
        if (IsVisible && !_wasVisible) {
            _title = _description = _error = "";
            _start = Start;
            _end = End;
            _allDay = true;
            _highPriority = false;
            _defaultColor = true;
            _color = "#999999";
            _category = EventCategory.Meeting;
        }

        _wasVisible = IsVisible;
    }

    private async Task SaveAsync() {
        var title = _title.Trim();
        if (title.Length is < 1 or > 128) {
            _error = "Event name is required (max 128 characters).";
            return;
        }

        if (_end < _start) {
            _error = "End date must not be before start date.";
            return;
        }

        EventTimeRequest time;
        try {
            if (_allDay) {
                time = new EventTimeRequest { IsAllDay = true, StartDate = _start, EndDateExclusive = _end.AddDays(1) };
            }
            else {
                var from = ToUtc(_start, _startTime);
                var to = ToUtc(_end, _endTime);
                if (to <= from) {
                    _error = "End must be later than start.";
                    return;
                }

                time = new EventTimeRequest { IsAllDay = false, StartsAtUtc = from, EndsAtUtc = to };
            }
        }
        catch (TimeZoneNotFoundException) {
            _error = "Unknown room time zone.";
            return;
        }

        _isSaving = true;
        _error = "";
        try {
            var res = await Api.PostAsync($"api/rooms/{RoomId}/events", new CreateEventRequest {
                Title = title,
                Description = string.IsNullOrWhiteSpace(_description) ? null : _description.Trim(),
                Time = time,
                Category = _category,
                Color = _defaultColor ? null : _color.TrimStart('#'),
                IsHighPriority = _highPriority
            });
            await ApiClient.EnsureSuccessAsync(res);
            await OnSaved.InvokeAsync();
        }
        catch (ApiException e) {
            _error = e.Message;
        }
        catch (HttpRequestException e) {
            _error = "Cannot reach the server. " + e.Message;
        }
        finally {
            _isSaving = false;
        }
    }

    private DateTimeOffset ToUtc(DateOnly date, TimeOnly time) {
        var tz = TimeZoneInfo.FindSystemTimeZoneById(RoomTimeZoneId);
        var local = DateTime.SpecifyKind(date.ToDateTime(time), DateTimeKind.Unspecified);
        return new DateTimeOffset(TimeZoneInfo.ConvertTimeToUtc(local, tz), TimeSpan.Zero);
    }

    private Task HandleClose() {
        _error = "";
        return OnClose.InvokeAsync();
    }

}