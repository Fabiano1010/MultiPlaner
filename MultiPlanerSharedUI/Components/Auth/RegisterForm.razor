@using System.Net.Mail
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.JSInterop
@using MultiPlanerSharedUI.Components.Auth
@layout AuthLayout
@inject AuthService Auth
@inject NavigationManager Nav
@using System.Net.Mail
@inject IJSRuntime JS

<form class="auth-form" @onsubmit="RegisterAsync" @onsubmit:preventDefault>
    <div class="input-group">
        <label for="name">Name</label>
        <input @bind="_name" id="name" placeholder="Name"
               class="auth-input @(_hasErrorName ? "error-input" : "")" disabled="@Locked"/>
        <div class="input-error"></div>
    </div>
    <div class="input-group">
        <label for="email">Email</label>
        <input @bind="_email" id="email" placeholder="Email"
               class="auth-input @(_hasError ? "error-input" : "")" disabled="@Locked"/>
        <div class="input-error"></div>
    </div>

    <div class="input-group">
        <label for="password">Password</label>
        <div class="password-wrapper">
            <input @bind="_password" @bind:event="oninput"
                   type="@(_showPassword ? "text" : "password")"
                   id="password" placeholder="Password"
                   class="auth-input-pass @(_hasErrorPassword ? "error-input" : "")" disabled="@Locked"/>
            <button type="button" class="toggle-password"
                    @onclick="() => _showPassword = !_showPassword"
                    aria-label="@(_showPassword ? "Hide password" : "Show password")">
                <img src="_content/MultiPlanerSharedUI/images/@(_showPassword ? "eye-off.svg" : "eye.svg")"
                     alt=""/>
            </button>
        </div>
    </div>

    <div class="input-group">
        <label for="passwordConfirm">Confirm Password</label>
        <div class="password-wrapper ">
            <input @bind="_passwordConfirm" @bind:event="oninput"
                   type="@(_showPasswordConfirm ? "text" : "password")"
                   id="passwordConfirm" placeholder="Confirm Password"
                   class="auth-input-pass @(_hasErrorPassword ? "error-input" : "")" disabled="@Locked"/>
            <button type="button" class="toggle-password"
                    @onclick="() => _showPasswordConfirm = !_showPasswordConfirm"
                    aria-label="@(_showPasswordConfirm ? "Hide password" : "Show password")">
                <img
                    src="_content/MultiPlanerSharedUI/images/@(_showPasswordConfirm ? "eye-off.svg" : "eye.svg")"
                    alt=""/>
            </button>
        </div>
        <div class="input-error"></div>
    </div>

    <button type="submit"
            class="auth-btn @(CanSubmit ? "btn-main" : "")"
            disabled="@(!CanSubmit)">Register
    </button>

    @if (_error is not null) {
        <span class="error">@_error</span>
    }
    @ChildContent
</form>

@code {
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback<bool> BusyChanged { get; set; }
    [Parameter] public EventCallback<RegisterCredentials> OnSuccess { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    
    public sealed record RegisterCredentials(string Email, string Password);
    
    private string _email = "";
    private string _password = "";
    private string _passwordConfirm = "";
    private string _name = "";
    private string _countryCode = "PL";
    private string _timeZoneId = "Europe/Warsaw";
    private string? _error;
    private bool _busy;

    private bool Locked => _busy || Disabled;
    
    private bool CanSubmit => !Locked
                              && !string.IsNullOrWhiteSpace(_name)
                              && MailAddress.TryCreate(_email, out _)
                              && !string.IsNullOrWhiteSpace(_password) && _password == _passwordConfirm;

    private bool _showPassword;
    private bool _showPasswordConfirm;
    private bool _hasError;
    private bool _hasErrorPassword;
    private bool _hasErrorName;

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (!firstRender) return;

        try {
            await using var module = await JS.InvokeAsync<IJSObjectReference>(
                "import", "./_content/MultiPlanerSharedUI/js/locale.js");
            _timeZoneId = await module.InvokeAsync<string?>("getTimeZone") ?? _timeZoneId;
            _countryCode = await module.InvokeAsync<string?>("getCountryCode") ?? _countryCode;

            StateHasChanged();
        }
        catch {
            // default values will be used if detection fails
        }
    }


    async Task RegisterAsync() {
        _error = null;
        _hasError = false;
        _hasErrorPassword = false;
        _hasErrorName = false;
        try {
            await Auth.RegisterAsync(_name, _email, _password, _countryCode, _timeZoneId);
            await OnSuccess.InvokeAsync(new RegisterCredentials(_email.Trim(), _password));
        }
        catch (ApiException ex) {
            _error = ex.Status == 409 ? "This account already exists." : ex.Message;
            if (ex.Status == 400 && ex.Message.Contains("Password")) {
                _hasErrorPassword = true;
            }

            if (ex.Status == 409) {
                _hasError = true;
            }

            if (ex.Status == 400 && ex.Message.Contains("DisplayName")) {
                _hasErrorName = true;
            }
        }
        catch (HttpRequestException e) {
            _error = "Cannot connect to server. " + e.Message;
        }
    }

}