@using System.Net.Mail
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthService Auth

<form class="auth-form" @onsubmit="LoginAsync" @onsubmit:preventDefault>
    <div class="input-group">
        <label for="email">Email</label>
        <input @bind="_email" disabled="@IsDisabled" id="email" placeholder="Email"
               class="auth-input @(_hasError ? "error-input" : "")"/>
        <div class="input-error"></div>
    </div>

    <div class="input-group">
        <label for="password">Password</label>
        <div class="password-wrapper">
            <input @bind="_password" @bind:event="oninput"
                   type="@(_showPassword ? "text" : "password")" disabled="@IsDisabled"
                   id="password" placeholder="Password"
                   class="auth-input-pass @(_hasError ? "error-input" : "")"/>
            <button type="button" class="toggle-password" disabled="@IsDisabled"
                    @onclick="() => _showPassword = !_showPassword"
                    aria-label="@(_showPassword ? "Hide password" : "Show password")">
                <img src="_content/MultiPlanerSharedUI/images/@(_showPassword ? "eye-off.svg" : "eye.svg")"
                     alt=""/>
            </button>
        </div>
        <div class="input-error"></div>
        <div class="password-reset-direction">
            <a href="/reset-password">Forgot your password?</a>
        </div>
    </div>

    <div class="remember-group">
        <div class="rememberMe-box"><input type="checkbox" @bind="_remember" disabled="@IsDisabled" id="remember"> <label
                for="remember">Remember Me</label></div>
    </div>
    <button type="submit"
            class="auth-btn @(CanSubmit ? "btn-main" : "")"
            disabled="@(!CanSubmit)">@(_busy ? "Logging in…" : "Login")
    </button>

    @if (_error is not null) {
        <span class="error" role="alert">@_error</span>
    }
    @ChildContent
</form>

@code {
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback<bool> BusyChanged { get; set; }
    [Parameter] public EventCallback<AuthenticationState> OnSuccess { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    
    private string _email = string.Empty;
    private string _password = string.Empty;
    private string? _error;
    private bool _remember;
    private bool _showPassword;
    private bool _hasError;
    private bool _busy;

    private bool IsDisabled => Disabled || _busy;
    private bool CanSubmit => !IsDisabled && !string.IsNullOrWhiteSpace(_password) &&
                              MailAddress.TryCreate(_email, out _);

    private async Task LoginAsync() {
        if (!CanSubmit) return;

        _error = null;
        _hasError = false;
        _busy = true;
        try {
            await BusyChanged.InvokeAsync(true);
            var state = await Auth.LoginAsync(_email, _password, _remember);
            await OnSuccess.InvokeAsync(state);
        }
        catch (ApiException ex) {
            _error = ex.Status == 401 ? "Invalid email or password." : ex.Message;
            _hasError = ex.Status == 401;
        }
        catch (HttpRequestException) {
            _error = "Cannot connect to the server. Try again.";
        }
        finally {
            _busy = false;
            await BusyChanged.InvokeAsync(false);
        }
    }
}
