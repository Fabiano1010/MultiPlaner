@page "/"
@using Microsoft.AspNetCore.Components.Authorization
@layout AuthLayout
@inject NavigationManager Nav
@attribute [AllowAnonymous]

<AuthorizeView>
    <Authorized><RedirectTo Url="/dashboard" /></Authorized>
    <NotAuthorized>

        <div class="main-content-box-auth">
            <div class="home-box-notloggedin">
                <div>
                    <div class="welcome-msg">Welcome to </div>
                    <div class="title-text">MultiPlaner</div>
                </div>
                <div class="logo-large">
                    <img src="_content/MultiPlanerSharedUI/images/logo.svg" alt="MultiPlaner Logo" class="logo-img-large">
                    
                </div>
                <div class="home-btn-group">
                    <button @onclick="Register" class="btn-main home-btns">Register</button>
                    <button @onclick="Login" class="btn-main home-btns">Login</button>
                    <button @onclick="About" class="btn-main home-btns">About</button>
                </div>
            </div>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    private async Task Register() {
        Nav.NavigateTo("/register");
    }

    private async Task Login() {
        Nav.NavigateTo("/login");
    }

    private async Task About() {
        Nav.NavigateTo("/about");
    }
}