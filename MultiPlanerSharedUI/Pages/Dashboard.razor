@page "/Dashboard"
@using Microsoft.AspNetCore.Components.Authorization

@layout MainLayout
@attribute [Authorize]


<div class="main-content-dashboard">
    <div class="dashboard-header">
        <h2 class="welcome-msg">Hello @_username</h2>
        <p>What are we planning to do today?</p>
    </div>
    <div class="dashboard-content">
        <div class="dashboard-left">
            <div class="dashboard-left-header">
                <h3>Your recent calendars</h3>
            </div>
            <div class="dashboard-left-content">
                
            </div>
        </div>
        <div class="dashboard-right">
            <div class="dashboard-ongoing-events">
                <h3>Ongoing events</h3>
                
            </div>
            <div class="dashboard-upcoming-events">
                <h3>Upcoming events</h3>
                
            </div>
        </div>
    </div>
</div>



@code {

    [CascadingParameter] private Task<AuthenticationState>? AuthenticationState { get; set; }

    private string? _username;

    protected override async Task OnInitializedAsync() {
        if (AuthenticationState != null) {
            var authState = await AuthenticationState;
            var user = authState.User;
            _username = user.Identity?.Name;
        }
    }

}