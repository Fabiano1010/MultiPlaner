@page "/join/{Token}"
@layout AuthLayout
@attribute [AllowAnonymous]
@using System.Net.Http.Json
@using System.Text.Json
@using Microsoft.AspNetCore.Components.Authorization
@using MultiPlanerSharedModels.Contracts.Rooms
@using MultiPlanerSharedUI.Components.Auth
@inject ApiClient Api
@inject ApiAuthStateProvider Auth
@inject NavigationManager Nav
@implements IDisposable

<div class="main-content-box-auth">
    <h2>Calendar invitation</h2>
    @if (_preview is not null) {
        <p class="invitation-calendar">@_preview.RoomName</p>
    }
    @if (_loading) {
        <p role="status">Loading invitation…</p>
    }
    else if (_preview is not null) {
        var version = _routeVersion;
        <div class="invitation-choices @(ShowLogin ? "with-login" : null)">
            @if (ShowLogin) {
                <section class="form-box invitation-option" aria-labelledby="invitation-login-heading">
                    <h3 id="invitation-login-heading">Log in to your account</h3>
                    <LoginForm @key="version" Disabled="_joining"
                               BusyChanged="busy => SetLoginBusy(version, busy)"
                               OnSuccess="state => OnLoginSuccessAsync(version, state)"/>
                </section>
            }
            <section class="form-box invitation-option" aria-labelledby="invitation-join-heading">
                <h3 id="invitation-join-heading">@(ShowLogin ? "Join as a guest" : "Join calendar")</h3>
                <form class="auth-form" @onsubmit="JoinAsync" @onsubmit:preventDefault>
                    @if (_needsDisplayName && _joinedRoomId is null) {
                        <div class="input-group">
                            <label for="guest-display-name">Guest display name</label>
                            <input id="guest-display-name" class="auth-input" @bind="_displayName"
                                   required minlength="2" maxlength="64" disabled="@JoinDisabled"/>
                        </div>
                    }
                    <button type="submit" class="auth-btn btn-main" disabled="@JoinDisabled">
                        @(_joining ? "Please wait…" : _joinedRoomId is null ? "Join" : "Open calendar")
                    </button>
                </form>
            </section>
        </div>
    }

    @if (_error is not null) {
        <p class="error" role="alert">@_error</p>
    }
</div>

@code {
    [Parameter] public string Token { get; set; } = string.Empty;
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    private string? _loadedToken;
    private int _routeVersion;
    private InvitationPreviewResponse? _preview;
    private int? _joinedRoomId;
    private string _displayName = string.Empty;
    private string? _error;
    private bool _needsDisplayName;
    private bool _hasAccount;
    private bool _loading;
    private bool _joining;
    private bool _loggingIn;

    private bool ShowLogin => !_hasAccount && _joinedRoomId is null;
    private bool JoinDisabled => _joining || _loggingIn;

    protected override Task OnParametersSetAsync() {
        if (_loadedToken == Token) return Task.CompletedTask;

        _loadedToken = Token;
        _joining = false;
        _loggingIn = false;
        _preview = null;
        _joinedRoomId = null;
        _displayName = string.Empty;
        return LoadPreviewAsync(++_routeVersion, AuthState);
    }

    private void SetLoginBusy(int version, bool busy) {
        if (version == _routeVersion) _loggingIn = busy;
    }

    private Task OnLoginSuccessAsync(int version, AuthenticationState state) {
        return version == _routeVersion
            ? LoadPreviewAsync(version, Task.FromResult(state))
            : Task.CompletedTask;
    }

    private async Task LoadPreviewAsync(int version, Task<AuthenticationState> authState) {
        _loading = true;
        _error = null;
        try {
            using var response = await Api.PostAsync("api/invitations/preview",
                new PreviewInvitationRequest { Token = Token });
            await ApiClient.EnsureSuccessAsync(response);
            var preview = await response.Content.ReadFromJsonAsync<InvitationPreviewResponse>();
            var state = await authState;
            if (version != _routeVersion) return;

            _preview = preview;
            _needsDisplayName = state.User.Identity?.IsAuthenticated != true;
            _hasAccount = state.User.HasClaim("kind", "user");
            if (_preview is null) _error = "Could not load the invitation.";
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException or JsonException) {
            if (version != _routeVersion) return;
            _preview = null;
            _error = InvitationError(ex, "Could not load the invitation.");
        }
        finally {
            if (version == _routeVersion) _loading = false;
        }
    }

    private async Task JoinAsync() {
        if (_preview is null || _loading || JoinDisabled) return;

        _error = null;
        var displayName = _needsDisplayName ? _displayName.Trim() : null;
        if (_joinedRoomId is null && displayName is not null && (displayName.Length is < 2 or > 64)) {
            _error = "Display name must contain 2 to 64 characters.";
            return;
        }

        var version = _routeVersion;
        _joining = true;
        try {
            if (_joinedRoomId is null) {
                using var response = await Api.PostAsync("api/invitations/join",
                    new JoinByTokenRequest { Token = Token, DisplayName = displayName });
                await ApiClient.EnsureSuccessAsync(response);
                var room = await response.Content.ReadFromJsonAsync<RoomResponse>();
                if (version != _routeVersion) return;
                if (room is null) {
                    _error = "Could not open the calendar.";
                    return;
                }
                _joinedRoomId = room.Id;
            }

            var state = await Auth.RefreshAuthStateAsync();
            if (version != _routeVersion) return;
            if (state.User.Identity?.IsAuthenticated != true) {
                _error = "Could not verify your session. Try opening the calendar again.";
                return;
            }

            Nav.NavigateTo($"calendar/{_joinedRoomId.Value}", replace: true);
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException or JsonException) {
            if (version != _routeVersion) return;
            _error = InvitationError(ex, "Could not join the calendar.");
            if (ex is ApiException { Status: 404 or 410 }) _preview = null;
        }
        finally {
            if (version == _routeVersion) _joining = false;
        }
    }

    private static string InvitationError(Exception ex, string fallback) => ex switch {
        ApiException { Status: 404 } => "This invitation link is invalid.",
        ApiException { Status: 410 } => "This invitation is no longer available.",
        ApiException { Code: "validation_failed" } validation => validation.Message,
        HttpRequestException { StatusCode: null } => "Cannot connect to the server. Try again.",
        _ => fallback
    };

    public void Dispose() => _routeVersion++;
}
