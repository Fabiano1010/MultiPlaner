@page "/Rooms"
@using MultiPlanerSharedUI.Components.Rooms
@layout MainLayout
@attribute [Authorize]

<div class="main-content-rooms">
    
    <div class="rooms-folders-container">
        
    </div>
    <div class="add-room-button" @onclick="() => showPopup = true">
        <img src="_content/MultiPlanerSharedUI/images/plus.svg"/>
    </div>
    <AddCalendarForm
        IsVisible="showPopup"
        OnClose="HandleClose">
    </AddCalendarForm>
</div>

@code {
    [Parameter] public EventCallback OnClose { get; set; }
    
    bool showPopup = false;
    string ErrorMessage;
    private async Task HandleClose() {
        showPopup = false;
    }
}