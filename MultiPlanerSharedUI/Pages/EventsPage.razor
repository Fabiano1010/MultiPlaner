@page "/events"
@layout MainLayout
@attribute [Authorize]
@implements IDisposable
@using System.Text.Json
@using MultiPlanerSharedModels.Contracts.Common
@using MultiPlanerSharedModels.Contracts.Events
@using MultiPlanerSharedUI.Components.Events
@inject ApiClient Api
@inject NavigationManager Nav

<div class="my-events-page">
    <div class="my-events-toolbar">
        <div class="my-events-toolbar-controlls">
            <div class="password-wrapper search-wrapper">
                <button type="button" class="search-img-btn" @onclick="ApplySearchNow">
                    <img src="_content/MultiPlanerSharedUI/images/search.svg" alt="search">
                </button>
                <input class="auth-input-pass input-search" type="search" placeholder="Search"
                       value="@_search"
                       @oninput="OnSearch"/>
                @if (!string.IsNullOrEmpty(_search)) {
                    <button type="button" class="toggle-password" title="Clear" @onclick="ClearSearch">✕</button>
                }

            </div>

            <label class="switch-row toolbar-switch" title="Show each recurring event only once">
                <span class="switch">
                    <input type="checkbox" role="switch" @bind="_collapse" @bind:after="OnCollapseChanged"/>
                    <span class="switch-slider"></span>
                </span>
                <span>Recurring once</span>
            </label>

            <button type="button" class="btn-main @(_adv is null ? "btn-cancel" : "btn-save") btn-adv-search"
                    @onclick="() => _showAdvanced = true">
                <img src="_content/MultiPlanerSharedUI/images/adjustments-horizontal.svg" alt="Advanced Search"
                     class="adv-search-img"/>
            </button>
        </div>
        @if (!_loading) {
            <div class="my-events-count">
                @_filtered.Count @(_filtered.Count == 1 ? "event" : "events")
                @if (_adv is { } a) {
                    @if (a.From is { } f && a.To is { } t) {
                        <text> · @f.ToString("dd.MM.yyyy") – @t.ToString("dd.MM.yyyy")</text>
                    }

                    @if (a.Priority != "all") {
                        <text> · @a.Priority priority</text>
                    }

                    @if (a.Time != "all") {
                        <text> · @a.Time</text>
                    }

                    <button type="button" class="toggle-password adv-clear" title="Clear search"
                            @onclick="ClearAdvancedAsync">✕
                    </button>
                }
            </div>
        }
    </div>
    

</div>
<div class="my-events-content">
    @if (_loading) {
        <LoadingSpinner/>
    }
    else if (_error is not null) {
        <div class="error-message">@_error</div>
        <button type="button" class="btn-main btn-cancel" @onclick="() => LoadAsync()">Retry</button>
    }
    else {
        <EventsList Events="_pageItems"
                    EmptyText="@(_all.Count == 0 ? (_adv is null ? "You have no events yet." : "No events in this range.") : "No events match your filters.")"
                    OnOpen="OpenDetails"
                    OnOpenCalendar="OpenCalendar"/>

        @if (_totalPages > 1) {
            <nav class="my-events-pager" aria-label="Pages">
                <button type="button" class="btn-main btn-cancel" disabled="@(_page <= 1)"
                        @onclick="() => GoTo(_page - 1)">‹ Previous
                </button>
                <span>Page @_page of @_totalPages</span>
                <button type="button" class="btn-main btn-cancel" disabled="@(_page >= _totalPages)"
                        @onclick="() => GoTo(_page + 1)">Next ›
                </button>
            </nav>
        }
    }
</div>

<EventDetails IsVisible="_showDetails"
              Event="_selected"
              RoomId="_roomId"
              OnClose="CloseDetails"
              OnChanged="() => LoadAsync(silent: true)"
/>
<AdvancedSearchPopup IsVisible="_showAdvanced"
                     Current="_adv"
                     OnClose="() => _showAdvanced = false"
                     OnApply="ApplyAdvancedAsync"
                     OnClear="ClearAdvancedAsync"/>

@code {
    private const int PageSize = 15;
    private const int PastDays = 90, FutureDays = 270;
    private const int FetchPageSize = 100;

    private List<EventResponse> _all = new();
    private List<EventResponse> _filtered = new();
    private List<EventResponse> _pageItems = new();

    private string _search = "";
    private bool _collapse = true;
    private int _page = 1, _totalPages = 1;
    private bool _loading = true, _showDetails;
    private bool _showAdvanced;
    private string? _error;
    private EventResponse? _selected;
    private CancellationTokenSource? _cts;
    private int _roomId;
    private AdvancedSearchFilter? _adv;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync(bool silent = false) {
        _cts?.Cancel();
        _cts?.Dispose();
        _cts = new CancellationTokenSource();
        var ct = _cts.Token;

        if (!silent) _loading = true;
        _error = null;

        var now = DateTimeOffset.UtcNow;
        var fromDt = _adv?.From is { } fd ? LocalMidnight(fd) : now.AddDays(-PastDays);
        var toDt = _adv?.To is { } td ? LocalMidnight(td.AddDays(1)) : now.AddDays(FutureDays);
        var from = Uri.EscapeDataString(fromDt.ToString("O"));
        var to = Uri.EscapeDataString(toDt.ToString("O"));

        try {
            var all = new List<EventResponse>();
            for (var page = 1; page <= 50; page++) {
                var url = $"api/me/events?from={from}&to={to}&status=all&page={page}&pageSize={FetchPageSize}";
                var result = await Api.GetAsync<PagedResponse<EventResponse>>(url, ct);
                if (result is null || result.Items.Count == 0) break;

                all.AddRange(result.Items);
                if (all.Count >= result.TotalCount) break;
            }

            if (ct.IsCancellationRequested) return;
            _all = all;
            Apply();
        }
        catch (OperationCanceledException) {
        }
        catch (ApiException e) {
            _error = e.Message;
        }
        catch (HttpRequestException e) {
            _error = "Cannot load events. " + e.Message;
        }
        catch (JsonException) {
            _error = "Unexpected response from the server.";
        }
        finally {
            if (!ct.IsCancellationRequested) _loading = false;
        }
    }


    private void Apply(bool resetPage = false) {
        var now = DateTimeOffset.UtcNow;
        var term = _search.Trim();
        var priority = _adv?.Priority ?? "all";
        var time = _adv?.Time ?? "all";

        IEnumerable<EventResponse> query = _all;

        if (term.Length > 0)
            query = query.Where(e => Contains(e.Title, term) || Contains(e.RoomName, term));

        query = priority switch {
            "high" => query.Where(e => e.IsHighPriority),
            "normal" => query.Where(e => !e.IsHighPriority),
            _ => query
        };

        query = time switch {
            "incoming" => query.Where(e => e.EndsAtUtc > now),
            "outdated" => query.Where(e => e.EndsAtUtc <= now),
            _ => query
        };

        if (_collapse)
            query = query.OrderBy(e => e.StartsAtUtc).GroupBy(e => e.Id).Select(g => g.First());

        _filtered = query
            .OrderBy(e => e.EndsAtUtc <= now)
            .ThenByDescending(e => e.IsHighPriority)
            .ThenBy(e => e.EndsAtUtc > now ? e.StartsAtUtc : DateTimeOffset.MaxValue)
            .ThenByDescending(e => e.EndsAtUtc <= now ? e.StartsAtUtc : DateTimeOffset.MinValue)
            .ThenBy(e => e.Id)
            .ToList();

        _totalPages = Math.Max(1, (int)Math.Ceiling(_filtered.Count / (double)PageSize));
        _page = resetPage ? 1 : Math.Clamp(_page, 1, _totalPages);
        _pageItems = _filtered.Skip((_page - 1) * PageSize).Take(PageSize).ToList();
    }

    private static bool Contains(string? value, string term) =>
        value is not null && value.Contains(term, StringComparison.CurrentCultureIgnoreCase);

    private void OnSearch(ChangeEventArgs e) {
        _search = e.Value?.ToString() ?? "";
        Apply(resetPage: true);
    }

    private void OnCollapseChanged() => Apply(resetPage: true);

    private void ApplySearchNow() {
        Apply(resetPage: true);
    }

    private void ClearSearch() {
        _search = "";
        Apply(resetPage: true);
    }

    private void GoTo(int page) {
        _page = Math.Clamp(page, 1, _totalPages);
        _pageItems = _filtered.Skip((_page - 1) * PageSize).Take(PageSize).ToList();
    }

    private void OpenDetails(EventResponse ev) {
        _selected = ev;
        _roomId = _selected.RoomId;
        _showDetails = true;
    }

    private void CloseDetails() {
        _showDetails = false;
        _selected = null;
    }

    private void OpenCalendar(int roomId) => Nav.NavigateTo($"/calendar/{roomId}");

    public void Dispose() {
        _cts?.Cancel();
        _cts?.Dispose();
    }

    private async Task ApplyAdvancedAsync(AdvancedSearchFilter filter) {
        _showAdvanced = false;
        _adv = filter;
        _page = 1;
        await LoadAsync();
    }

    private async Task ClearAdvancedAsync() {
        _showAdvanced = false;
        _adv = null;
        _page = 1;
        await LoadAsync();
    }

    private static DateTimeOffset LocalMidnight(DateOnly d) =>
        new(DateTime.SpecifyKind(d.ToDateTime(TimeOnly.MinValue), DateTimeKind.Local));

}