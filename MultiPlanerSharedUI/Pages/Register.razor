@page "/register"
@layout AuthLayout
@inject AuthService Auth
@inject NavigationManager Nav
@attribute [AllowAnonymous]


<div class="main-content-box-auth ">
    <h2>Register</h2>
    <div class="form-box auth-register">
        <div class="auth-form">
            <div class="input-group">
                <label for="name">Name</label>
                <input @bind="name" id="name" placeholder="Name" class="auth-input"/>
                <div class="input-error"></div>
            </div>
            <div class="input-group">
                <label for="email">Email</label>
                <input @bind="email" id="email" placeholder="Email" class="auth-input"/>
                <div class="input-error"></div>
            </div>

            <div class="input-group">
                <label for="password">Password</label>
                <div class="password-wrapper">
                    <input @bind="password" @bind:event="oninput"
                           type="@(showPassword ? "text" : "password")"
                           id="password" placeholder="Password" class="auth-input-pass"/>
                    <button type="button" class="toggle-password"
                            @onclick="() => showPassword = !showPassword"
                            aria-label="@(showPassword ? "Hide password" : "Show password")">
                        <img src="_content/MultiPlanerSharedUI/images/@(showPassword ? "eye-off.svg" : "eye.svg")" alt="" />
                    </button>
                </div>
            </div>

            <div class="input-group">
                <label for="passwordConfirm">Confirm Password</label>
                <div class="password-wrapper">
                    <input @bind="passwordConfirm" @bind:event="oninput"
                           type="@(showPasswordConfirm ? "text" : "password")"
                           id="passwordConfirm" placeholder="Confirm Password" class="auth-input-pass"/>
                    <button type="button" class="toggle-password"
                            @onclick="() => showPasswordConfirm = !showPasswordConfirm"
                            aria-label="@(showPasswordConfirm ? "Hide password" : "Show password")">
                        <img src="_content/MultiPlanerSharedUI/images/@(showPasswordConfirm ? "eye-off.svg" : "eye.svg")" alt="" />
                    </button>
                </div>
                <div class="input-error"></div>
            </div>
            
            <button @onclick="RegisterAsync" class="auth-btn" disabled="@(!CanSubmit)">Register</button>

            @if (error is not null) {
                <p class="error">@error</p>
            }
            <div class="register-direction">
                <p>Already have an account? <a href="/login">Log in</a></p>
            </div>
        </div>
    </div>
</div>



@code {
    string email = "", password = "", passwordConfirm = "" , name = "", error, countryCode = "PL", timeZoneId = "Europe/Warsaw";
    
    bool CanSubmit => !string.IsNullOrWhiteSpace(email) && System.Net.Mail.MailAddress.TryCreate(email, out _) && !string.IsNullOrWhiteSpace(password) && password == passwordConfirm && !string.IsNullOrWhiteSpace(name);
    bool remember = false, showPassword = false, showPasswordConfirm = false;
    async Task RegisterAsync() {
        error = null;
        try {
            await Auth.RegisterAsync(name, email, password, countryCode, timeZoneId);
            Nav.NavigateTo("/");
        } catch (Exception ex) {
            error = ex.Message;
        }
    }
}