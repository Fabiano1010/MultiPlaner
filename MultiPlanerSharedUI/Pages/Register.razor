@page "/register"
@layout AuthLayout
@inject AuthService Auth
@inject NavigationManager Nav
@attribute [AllowAnonymous]

<h2>Register</h2>

<div>

    <input @bind="name" placeholder="Name">
    <input @bind="email" placeholder="Email"/>
    <input @bind="password" type="password" placeholder="Password"/>
    <input @bind="passwordConfirm" type="password" placeholder="Confirm Password"/>
    <button @onclick="RegisterAsync">Register</button>
    
    @if (error is not null) {
        <p class="error">@error</p>
    }
    
</div>

@code {
    string email = "", password = "", passwordConfirm = "" , name = "", error, countryCode = "PL", timeZoneId = "Europe/Warsaw";
    
    
    bool remember = false;
    async Task RegisterAsync() {
        error = null;
        try {
            await Auth.RegisterAsync(name, email, password, countryCode, timeZoneId);
            Nav.NavigateTo("/");
        } catch (Exception ex) {
            error = ex.Message;
        }
    }
}