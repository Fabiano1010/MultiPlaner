@page "/register"
@using System.Net.Mail
@using Microsoft.JSInterop
@using MultiPlanerSharedUI.Components.Auth
@layout AuthLayout
@inject AuthService Auth
@inject NavigationManager Nav
@inject IJSRuntime Js

@attribute [AllowAnonymous]

<div class="main-content-box-auth ">
    <h2>Register</h2>
    <div class="form-box auth-register">
        <RegisterForm OnSuccess="NavigateLogin" >
            <div class="register-direction">
                <p>Already have an account? <a href="/login">Log in</a></p>
            </div>
        </RegisterForm>
    </div>
</div>



@code {
    private void NavigateLogin() => Nav.NavigateTo("/login");

}
