@page "/login"
@layout AuthLayout
@inject AuthService Auth
@inject NavigationManager Nav
@attribute [AllowAnonymous]

<div class="main-content-box-auth">
    <h2>Login</h2>
    <div class="form-box">
        <div class="auth-form">
            <div class="input-group">
                <label for="email">Email</label>
                <input @bind="email" id="email" placeholder="Email" class="auth-input"/>
                <div class="input-error"></div>
            </div>
            
            <div class="input-group">
                <label for="password">Password</label>
                <div class="password-wrapper">
                    <input @bind="password" @bind:event="oninput"
                           type="@(showPassword ? "text" : "password")"
                           id="password" placeholder="Password" class="auth-input-pass"/>
                    <button type="button" class="toggle-password"
                            @onclick="() => showPassword = !showPassword"
                            aria-label="@(showPassword ? "Hide password" : "Show password")">
                        <img src="_content/MultiPlanerSharedUI/images/@(showPassword ? "eye-off.svg" : "eye.svg")" alt="" />
                    </button>
                </div>
                <div class="input-error"></div>
                <div class="password-reset-direction">
                    <a href="/reset-password">Forgot your password?</a>
                </div>
            </div>
  
            <div class="remember-group">
                <div class="rememberMe-box"><input type="checkbox" @bind="remember" id="remember"> <label for="remember">Remember Me</label></div>
            </div>
            <button @onclick="LoginAsync" class="auth-btn" disabled="@(!CanSubmit)">Login</button>

            @if (error is not null) {
                <p class="error">@error</p>
            }
            <div class="register-direction">
                <p>Don't have an account? <a href="/register">Register here</a></p>
            </div>
        </div>
    </div>
</div>


@code {
    
    string email = "", password = "", error;
    bool remember = false;
    bool CanSubmit => !string.IsNullOrWhiteSpace(email) && !string.IsNullOrWhiteSpace(password) && System.Net.Mail.MailAddress.TryCreate(email, out _);
    bool showPassword;
    async Task LoginAsync() {
        error = null;
        try {
            await Auth.LoginAsync(email, password, remember);
            Nav.NavigateTo("/");
        } catch (Exception ex) {
            error = ex.Message;
        }
    }
}