@page "/login"
@layout AuthLayout
@inject AuthService Auth
@inject NavigationManager Nav
@attribute [AllowAnonymous]

<div class="main-content-box-auth">
    <h2>Login</h2>
    <div class="form-box">
        <div class="auth-form">
            <div class="input-group">
                <label for="email">Email</label>
                <input @bind="email" id="email" placeholder="Email" class="auth-input @(hasError ? "error-input" : "")" />
                <div class="input-error"></div>
            </div>
            
            <div class="input-group">
                <label for="password">Password</label>
                <div class="password-wrapper" @(CanSubmit ? "error-input" : "")>
                    <input @bind="password" @bind:event="oninput"
                           type="@(showPassword ? "text" : "password")"
                           id="password" placeholder="Password" class="auth-input-pass @(hasError ? "error-input" : "")"/>
                    <button type="button" class="toggle-password"
                            @onclick="() => showPassword = !showPassword"
                            aria-label="@(showPassword ? "Hide password" : "Show password")">
                        <img src="_content/MultiPlanerSharedUI/images/@(showPassword ? "eye-off.svg" : "eye.svg")" alt="" />
                    </button>
                </div>
                <div class="input-error"></div>
                <div class="password-reset-direction">
                    <a href="/reset-password">Forgot your password?</a>
                </div>
            </div>
  
            <div class="remember-group">
                <div class="rememberMe-box"><input type="checkbox" @bind="remember" id="remember"> <label for="remember">Remember Me</label></div>
            </div>
            <button @onclick="LoginAsync" class="auth-btn" disabled="@(!CanSubmit)">Login</button>

            @if (error is not null) {
                <span class="error">@error</span>
            }
            <div class="register-direction">
                <span>Don't have an account? <a href="/register">Register here</a></span>
            </div>
        </div>
    </div>
</div>


@code {

    string email = "";
    string password = "";
    string? error;
    bool remember = false;
    bool CanSubmit => !string.IsNullOrWhiteSpace(email) && !string.IsNullOrWhiteSpace(password) && System.Net.Mail.MailAddress.TryCreate(email, out _);
    bool showPassword = false;
    bool hasError;

    async Task LoginAsync()
    {
        error = null;
        hasError = false;
        try
        {
            await Auth.LoginAsync(email, password, remember);
            Nav.NavigateTo("/");
        }
        catch (ApiException ex)
        {
            error = ex.Status == 401 ? "Invalid email or password." : ex.Message;
            hasError = true;
        }
        catch (HttpRequestException e)
        {
            error = "Cannot connect to the server." + e.Message;
        }
    }
}