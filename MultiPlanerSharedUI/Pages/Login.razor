@page "/login"
@using MultiPlanerSharedUI.Components.Auth
@layout AuthLayout
@inject NavigationManager Nav
@attribute [AllowAnonymous]

<div class="main-content-box-auth">
    <h2>Login</h2>
    <div class="form-box">
        <LoginForm OnSuccess="NavigateHome"/>
    </div>
</div>

@code {
    private void NavigateHome() => Nav.NavigateTo("/");
}
